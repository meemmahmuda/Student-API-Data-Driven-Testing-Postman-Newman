              "pm.environment.set(\"mName\", middleName);\r",
              "\r",
              "// Random Last Name\r",
              "var lastName = pm.iterationData.get('last_name');\r",
              "pm.environment.set(\"lName\", lastName);\r",
              "\r",
              "// Random Date of Birth\r",
              "var dob = pm.iterationData.get('date_of_birth');\r",
