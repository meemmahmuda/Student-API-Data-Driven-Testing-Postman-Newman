    {
      "name": "Create Student",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Random First Name\r",
              "var firstName = pm.iterationData.get('first_name');\r",
              "pm.environment.set(\"fName\", firstName);\r",
              "\r",
              "// Random Middle Name\r",
